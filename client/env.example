# Copy to ~/.config/copilot-fim-proxy/env and chmod 600: it holds an API key.
# Backends are tried in order. Each one needs UPSTREAMn and MODELn.

# 1) Big model on a LAN server (vLLM, llama.cpp, or a LiteLLM gateway in front of them).
NAME1=lan-server
UPSTREAM1=https://llm.example.lan/v1/completions
MODEL1=granite-4.1-8b-fim
KEY1=change-me
CONNECT_TIMEOUT1=1.5

# 2) Small model on this machine (see systemd/ollama-autocomplete.service), for when the server is out of reach.
NAME2=local
UPSTREAM2=http://127.0.0.1:11435/v1/completions
MODEL2=qwen2.5-coder:1.5b-base

# Extra CA for an upstream with a private certificate. Empty: system store.
#CA_BUNDLE=/path/to/ca.crt

PORT=8788
MAX_PREFIX_CHARS=3000
MAX_SUFFIX_CHARS=800
MAX_TOKENS=64
SKIP_SECONDS=60
#LOG_LEVEL=DEBUG
