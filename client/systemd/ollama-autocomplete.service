# A user-level Ollama just for autocomplete: its own port and model folder,
# so it never fights the system Ollama for memory or permissions.
[Unit]
Description=Ollama for editor autocomplete

[Service]
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=%h/.local/share/ollama-autocomplete
Environment=OLLAMA_IGPU_ENABLE=1
Environment=OLLAMA_KEEP_ALIVE=-1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_CONTEXT_LENGTH=4096
ExecStart=/usr/bin/ollama serve
Restart=on-failure

[Install]
WantedBy=default.target
