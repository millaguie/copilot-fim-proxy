[Unit]
Description=Copilot inline completions -> own FIM models
After=ollama-autocomplete.service
Wants=ollama-autocomplete.service

[Service]
EnvironmentFile=%h/.config/copilot-fim-proxy/env
ExecStart=/usr/bin/python3 %h/.local/share/copilot-fim-proxy/proxy.py
Restart=on-failure

[Install]
WantedBy=default.target
