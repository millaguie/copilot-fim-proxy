# Copy to /opt/granite-fim/env. run.sh reads it; every value here has a default.
IMAGE=vllm/vllm-openai:latest
# Host folder with the models; MODEL is the path inside the container.
MODELS_DIR=/srv/models
MODEL=/models/granite-4.1-8b-base-w4a16
SERVED_NAME=granite-4.1-8b-fim
PORT=8002
# GPU access: for ROCm, the render node of the card (ls /dev/dri); for CUDA, leave empty and set GPU_ARGS.
RENDER_NODE=/dev/dri/renderD128
#GPU_ARGS=--gpus device=0
GPU_MEM=0.21
MAX_MODEL_LEN=4096
MAX_NUM_SEQS=2
REPETITION_PENALTY=1.15
# Container to wait for before starting (it shares the GPU). Empty: no wait.
WAIT_FOR=
